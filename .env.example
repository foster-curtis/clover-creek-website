# Copy to .env.local for development; set the same variables in Vercel for production.
# The site runs without any of these (with placeholders and booking disabled) —
# each service switches on when its keys are added. See SETUP.md.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.clovercreekguesthouse.com
# The real inbox: where owner notifications go and where guest replies land.
OWNER_EMAIL=clovercreekguesthouse@gmail.com
# Publicly displayed phone number: the Google Voice line, emitted as `telephone` in the
# structured data. Must match the phone on every external listing byte for byte (§6.2).
NEXT_PUBLIC_PHONE=+1-385-204-6622

# --- Supabase (database, auth, storage, realtime chat) -----------------------
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (payments) --------------------------------------------------------
# Stripe dashboard → Developers → API keys. Use test keys (sk_test_...) first.
STRIPE_SECRET_KEY=
# Developers → Webhooks → endpoint https://<site>/api/webhooks/stripe
# events: checkout.session.completed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=

# --- Resend (booking confirmation & notification emails) ----------------------
RESEND_API_KEY=
# After verifying the domain in Resend. Send-only alias — no inbox behind it, so
# every send sets Reply-To to a real address (see src/lib/email.ts).
EMAIL_FROM=Clover Creek Guest House <stay@clovercreekguesthouse.com>

# --- HERE Maps (map on the home page; falls back to OpenStreetMap if empty) ---
NEXT_PUBLIC_HERE_API_KEY=

# --- iCal feed ------------------------------------------------------------------
# Any long random string. /api/ical?key=<token> includes guest names (for the
# owner's Google Calendar); /api/ical without it shows busy dates only.
ICAL_FEED_TOKEN=
